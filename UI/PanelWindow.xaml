<Window x:Class="AIMouse.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Width="380" Height="400" MinWidth="240" MinHeight="160">
    <Border Margin="14" CornerRadius="14" Background="#FCFCFD" BorderBrush="#E3E3E8" BorderThickness="1"
            TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.14" />
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44" Background="Transparent" Padding="14,0,8,0" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
                        <Button x:Name="ReadAllBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="从头朗读全部英文（屏幕上会跟着框出正在读的句子）" Click="ReadAll_Click" />
                        <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Content="&#xE718;" ToolTip="实时翻译：内容变化（滚动）时自动更新" Click="Pin_Click" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" ToolTip="复制全部（英文 + 中文）" Click="Copy_Click" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="关闭" Click="Close_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo_256.png" Width="16" Height="16" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <ContentControl x:Name="SwitchHost" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Arrow" />
                        <TextBlock x:Name="TitleText" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F" FontFamily="{StaticResource UIFont}" VerticalAlignment="Center" />
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#34C759" Margin="6,1,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#86868B" Margin="8,0,0,0" FontFamily="{StaticResource UIFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="#EDEDF0" Margin="14,0" />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="8,8,8,16" PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,2" Background="{Binding Background}"
                                    MouseEnter="Item_MouseEnter" MouseLeave="Item_MouseLeave">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Width="24" Height="24" FontSize="12" Margin="4,-4,-6,0" VerticalAlignment="Top"
                                        Content="&#xE767;" ToolTip="朗读这句" Click="ItemSpeak_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding En, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontSize="13" Foreground="#6E6E73" Padding="0" Margin="-2,0,0,0"
                                             Cursor="Arrow" FontFamily="{StaticResource UIFont}" IsTabStop="False" Focusable="False"
                                             IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#007AFF" SelectionOpacity="0.25"
                                             PreviewMouseLeftButtonUp="En_MouseUp" MouseMove="En_MouseMove" ToolTip="点英文单词就能听发音"
                                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                                    <TextBlock Text="{Binding ZhDisplay}" TextWrapping="Wrap" FontSize="15" Foreground="{Binding ZhBrush}"
                                               FontFamily="Microsoft YaHei UI" Margin="0,4,0,0" LineHeight="22" />
                                </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
