<Window x:Class="AIMouse.UI.WordCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="-32000">
    <Border x:Name="Card" Margin="14" CornerRadius="14" Background="#FCFCFD" BorderBrush="#E3E3E8" BorderThickness="1"
            Padding="16,12,10,13" MinWidth="190" MaxWidth="370" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" />
        </Border.Effect>
        <Grid>
            <!-- Word layout -->
            <StackPanel x:Name="WordPanel">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                        <Button x:Name="SpeakBtn" Style="{StaticResource IconBtn}" Content="&#xE767;" ToolTip="朗读" Click="Speak_Click" />
                        <Button x:Name="StarBtn" Style="{StaticResource IconBtn}" Content="&#xE734;" ToolTip="加入生词本" Click="Star_Click" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WordText" FontSize="20" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,8,0" FontFamily="{StaticResource DisplayFont}"
                                   Cursor="Hand" ToolTip="点一下听发音" MouseLeftButtonUp="Word_MouseUp" />
                        <TextBlock x:Name="PhoneticText" FontSize="13" Foreground="#86868B" VerticalAlignment="Bottom" Margin="0,0,0,4" FontFamily="Segoe UI" />
                    </WrapPanel>
                </DockPanel>
                <TextBlock x:Name="MeaningLine" Margin="0,6,4,0" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI">
                    <Run x:Name="PosRun" Foreground="#007AFF" FontSize="13" FontStyle="Italic" /><Run x:Name="MeaningRun" FontSize="15.5" Foreground="#1D1D1F" />
                </TextBlock>
                <TextBlock x:Name="NoteText" Margin="0,5,4,0" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" />
                <TextBlock x:Name="SourceText" Margin="0,6,4,0" FontSize="11" Foreground="#AEAEB2" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" Visibility="Collapsed" />
                <Border x:Name="SentenceBox" BorderBrush="#EDEDF0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                    <DockPanel>
                        <Button x:Name="SentenceSpeakBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="12"
                                Content="&#xE767;" ToolTip="朗读整句英文" Click="SentenceSpeak_Click" VerticalAlignment="Top" Margin="4,-3,0,0" />
                        <TextBlock x:Name="SentenceText" FontSize="12.5" Foreground="#424245" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" />
                    </DockPanel>
                </Border>
            </StackPanel>
            <!-- Phrase layout -->
            <StackPanel x:Name="PhrasePanel" Visibility="Collapsed" Margin="0,0,4,0">
                <DockPanel>
                    <Button x:Name="PhraseSpeakBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE767;" ToolTip="朗读"
                            Click="PhraseSpeak_Click" VerticalAlignment="Top" Margin="6,-4,-4,0" />
                    <TextBox x:Name="PhraseEn" FontSize="13" Foreground="#6E6E73" TextWrapping="Wrap" FontFamily="{StaticResource UIFont}"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="-2,0,0,0"
                             Cursor="Arrow" IsTabStop="False" Focusable="False" MaxWidth="320"
                             IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#007AFF" SelectionOpacity="0.25"
                             PreviewMouseLeftButtonUp="PhraseEn_MouseUp" MouseMove="PhraseEn_MouseMove" ToolTip="点英文单词就能听发音"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
                <TextBlock x:Name="PhraseZh" FontSize="15.5" Foreground="#1D1D1F" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Microsoft YaHei UI" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
